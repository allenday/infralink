          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "limit",
        "returned"
      ],
      "title": "PageInfo",
      "type": "object"
    },
    "Page_str_": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PageInfo"
        }
      },
      "required": [
        "items",
        "page"
      ],
      "title": "Page[str]",
      "type": "object"
    }
