        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/Binding"
          },
          "title": "Bindings",
          "type": "object"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rel": {
          "title": "Rel",
          "type": "string"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        },
        "templated": {
          "default": false,
          "title": "Templated",
          "type": "boolean"
        }
      },
      "required": [
        "rel",
        "command",
        "description",
        "safe"
      ],
      "title": "Action",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "examples": {
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "syntax": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Syntax"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "required",
        "source"
      ],
      "title": "Binding",
      "type": "object"
    },
    "CommandContext": {
      "additionalProperties": false,
      "properties": {
        "parsed": {
          "additionalProperties": true,
          "title": "Parsed",
          "type": "object"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "resolved": {
          "additionalProperties": true,
          "title": "Resolved",
          "type": "object"
        }
      },
      "required": [
        "raw",
        "parsed",
        "resolved"
      ],
      "title": "CommandContext",
      "type": "object"
    },
    "EdgeShowResult": {
      "additionalProperties": false,
      "properties": {
