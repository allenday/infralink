{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "An internal action recipe with a compact public serialization.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/Binding"
          },
          "title": "Bindings",
          "type": "object"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rel": {
          "title": "Rel",
          "type": "string"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        },
        "templated": {
          "default": false,
          "title": "Templated",
          "type": "boolean"
        }
      },
      "required": [
        "rel",
        "command",
        "description",
        "safe"
      ],
      "title": "Action",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "required",
        "source"
      ],
      "title": "Binding",
      "type": "object"
    },
    "CheckCommandResult": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "$ref": "#/$defs/Page_CheckResult_"
        },
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "summary": {
          "$ref": "#/$defs/CheckSummary"
        }
      },
      "required": [
        "healthy",
        "checks",
        "summary"
      ],
      "title": "CheckCommandResult",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Ms"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "healthy",
        "status",
        "latency_ms",
        "error_code"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckSummary": {
      "additionalProperties": false,
      "properties": {
        "healthy": {
          "title": "Healthy",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "unhealthy": {
          "title": "Unhealthy",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "healthy",
        "unhealthy"
      ],
      "title": "CheckSummary",
      "type": "object"
    },
    "CommandContext": {
      "additionalProperties": false,
      "properties": {
        "parsed": {
          "additionalProperties": true,
          "title": "Parsed",
          "type": "object"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "resolved": {
          "additionalProperties": true,
          "title": "Resolved",
          "type": "object"
        }
      },
      "required": [
        "raw",
        "parsed",
        "resolved"
      ],
      "title": "CommandContext",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "PageInfo": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "returned": {
          "minimum": 0,
          "title": "Returned",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "required": [
        "limit",
        "returned"
      ],
      "title": "PageInfo",
      "type": "object"
    },
    "Page_CheckResult_": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Items",
          "type": "array"
        },
        "page": {
          "$ref": "#/$defs/PageInfo"
        }
      },
      "required": [
        "items",
        "page"
      ],
      "title": "Page[CheckResult]",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "ok",
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "properties": {
        "error": {
          "not": {
            "type": "null"
          }
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ]
    }
  ],
  "properties": {
    "command": {
      "$ref": "#/$defs/CommandContext"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fix"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "next_actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckCommandResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "infralink.cli/v1",
      "default": "infralink.cli/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "command",
    "next_actions"
  ],
  "title": "Envelope[CheckCommandResult]",
  "type": "object"
}
