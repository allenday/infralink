  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "ok",
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "properties": {
        "error": {
          "not": {
            "type": "null"
          }
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ]
    }
