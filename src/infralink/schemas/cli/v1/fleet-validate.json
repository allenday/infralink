    "schema_version": {
      "const": "infralink.cli/v1",
      "default": "infralink.cli/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "command",
    "next_actions"
  ],
  "title": "Envelope[FleetValidationResult]",
  "type": "object"
