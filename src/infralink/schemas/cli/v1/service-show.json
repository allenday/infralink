      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "ok",
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "properties": {
        "error": {
          "not": {
            "type": "null"
          }
        },
        "ok": {
          "const": false
        }
      },
