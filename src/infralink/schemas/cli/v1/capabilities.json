          "const": true
        },
        "result": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "ok",
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "properties": {
        "error": {
          "not": {
            "type": "null"
          }
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ]
    }
  ],
  "properties": {
    "command": {
      "$ref": "#/$defs/ObservationCommand"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
