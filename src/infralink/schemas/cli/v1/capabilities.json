        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "required",
        "source"
      ],
      "title": "Binding",
      "type": "object"
    },
    "CapabilitiesResult": {
      "additionalProperties": false,
