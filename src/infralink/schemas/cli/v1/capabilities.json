      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilitiesResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
