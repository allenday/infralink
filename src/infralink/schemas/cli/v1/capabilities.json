    "schema_version": {
      "const": "agent-cli.response.v1",
      "default": "agent-cli.response.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "generated_at",
    "ok",
    "command"
  ],
  "title": "ObservationEnvelope[CapabilitiesResult]",
  "type": "object"
