          },
          "title": "Bindings",
          "type": "object"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rel": {
          "title": "Rel",
          "type": "string"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        },
        "templated": {
          "default": false,
          "title": "Templated",
          "type": "boolean"
        }
      },
      "required": [
        "rel",
        "command",
        "description",
        "safe"
      ],
      "title": "Action",
      "type": "object"
    },
    "Binding": {
