{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "An internal action recipe with a compact public serialization.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/Binding"
          },
          "title": "Bindings",
          "type": "object"
        },
        "command": {
          "title": "Command",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rel": {
          "title": "Rel",
          "type": "string"
        },
        "safe": {
          "title": "Safe",
          "type": "boolean"
        },
        "templated": {
          "default": false,
          "title": "Templated",
          "type": "boolean"
        }
      },
      "required": [
        "rel",
        "command",
        "description",
        "safe"
      ],
      "title": "Action",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "examples": {
          "items": {
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "syntax": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Syntax"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "required",
        "source"
      ],
      "title": "Binding",
      "type": "object"
    },
    "CommandContext": {
      "additionalProperties": false,
      "properties": {
        "parsed": {
          "additionalProperties": true,
          "title": "Parsed",
          "type": "object"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "resolved": {
          "additionalProperties": true,
          "title": "Resolved",
          "type": "object"
        }
      },
      "required": [
        "raw",
        "parsed",
        "resolved"
      ],
      "title": "CommandContext",
      "type": "object"
    },
    "DoctorTarget": {
      "additionalProperties": false,
      "properties": {
        "canonical_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Name"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "type": {
          "enum": [
            "global",
            "host",
            "service",
            "edge",
            "profile"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "DoctorTarget",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "HostApplyPlan": {
      "additionalProperties": false,
      "properties": {
        "action_categories": {
          "items": {
            "enum": [
              "registry_checkout",
              "render",
              "reconcile"
            ],
            "type": "string"
          },
          "title": "Action Categories",
          "type": "array"
        },
        "dispatch_provider": {
          "const": "ssh",
          "title": "Dispatch Provider",
          "type": "string"
        },
        "reconcile_mode": {
          "const": "timer",
          "title": "Reconcile Mode",
          "type": "string"
        },
        "registry_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Registry Revision",
          "type": "string"
        }
      },
      "required": [
        "registry_revision",
        "dispatch_provider",
        "reconcile_mode",
        "action_categories"
      ],
      "title": "HostApplyPlan",
      "type": "object"
    },
    "HostApplyResult": {
      "additionalProperties": false,
      "properties": {
        "dispatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostDispatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostApplyPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ssh_host_identity": {
          "anyOf": [
            {
              "const": "passed",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ssh Host Identity"
        },
        "target": {
          "$ref": "#/$defs/DoctorTarget"
        },
        "target_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetReconcileStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "target"
      ],
      "title": "HostApplyResult",
      "type": "object"
    },
    "HostDispatch": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "ssh",
          "title": "Provider",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "status"
      ],
      "title": "HostDispatch",
      "type": "object"
    },
    "HostTimer": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "next_scheduled_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Scheduled At"
        }
      },
      "required": [
        "active"
      ],
      "title": "HostTimer",
      "type": "object"
    },
    "LastReconcile": {
      "additionalProperties": false,
      "properties": {
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "registry_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registry Sha"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "LastReconcile",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "OperationFailure": {
      "additionalProperties": false,
      "properties": {
        "journal": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Journal",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationUnitFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OperationFailure",
      "type": "object"
    },
    "OperationSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:op_[A-Za-z0-9_-]{8,128}|ssh/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{32})$",
          "title": "Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "applying",
            "converged",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "title": "OperationSummary",
      "type": "object"
    },
    "OperationUnitFailure": {
      "additionalProperties": false,
      "properties": {
        "active_state": {
          "title": "Active State",
          "type": "string"
        },
        "exec_main_status": {
          "title": "Exec Main Status",
          "type": "integer"
        },
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "active_state",
        "result",
        "exec_main_status"
      ],
      "title": "OperationUnitFailure",
      "type": "object"
    },
    "TargetReconcileStatus": {
      "additionalProperties": false,
      "properties": {
        "in_progress": {
          "title": "In Progress",
          "type": "boolean"
        },
        "last_reconcile": {
          "$ref": "#/$defs/LastReconcile"
        },
        "reconcile_mode": {
          "const": "timer",
          "title": "Reconcile Mode",
          "type": "string"
        },
        "timer": {
          "$ref": "#/$defs/HostTimer"
        }
      },
      "required": [
        "reconcile_mode",
        "timer",
        "in_progress",
        "last_reconcile"
      ],
      "title": "TargetReconcileStatus",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "not": {
            "type": "null"
          }
        }
      },
      "required": [
        "ok",
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "properties": {
        "error": {
          "not": {
            "type": "null"
          }
        },
        "ok": {
          "const": false
        }
      },
      "required": [
        "ok",
        "error"
      ]
    }
  ],
  "properties": {
    "command": {
      "$ref": "#/$defs/CommandContext"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fix"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "next_actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostApplyResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "infralink.cli/v1",
      "default": "infralink.cli/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "command",
    "next_actions"
  ],
  "title": "Envelope[HostApplyResult]",
  "type": "object"
}
