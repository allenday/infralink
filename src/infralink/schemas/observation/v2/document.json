{
  "$defs": {
    "ComparisonOperator": {
      "enum": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "ne"
      ],
      "title": "ComparisonOperator",
      "type": "string"
    },
    "ComponentEdge": {
      "additionalProperties": false,
      "description": "An edge whose ownership is derived from its component endpoint identities.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "source_endpoint_id": {
          "title": "Source Endpoint Id",
          "type": "string"
        },
        "target_endpoint_id": {
          "title": "Target Endpoint Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_endpoint_id",
        "target_endpoint_id"
      ],
      "title": "ComponentEdge",
      "type": "object"
    },
    "ComponentEndpointOverride": {
      "additionalProperties": false,
      "description": "Instance-specific transport and visibility values for one profile endpoint.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "endpoint_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "exposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointExposure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        }
      },
      "required": [
        "endpoint_id"
      ],
      "title": "ComponentEndpointOverride",
      "type": "object"
    },
    "ComponentInstance": {
      "additionalProperties": false,
      "description": "One realized component slot in a service instance.",
      "properties": {
        "endpoint_bindings": {
          "items": {
            "$ref": "#/$defs/EndpointBinding"
          },
          "title": "Endpoint Bindings",
          "type": "array"
        },
        "endpoint_overrides": {
          "items": {
            "$ref": "#/$defs/ComponentEndpointOverride"
          },
          "title": "Endpoint Overrides",
          "type": "array"
        },
        "metric_bindings": {
          "items": {
            "$ref": "#/$defs/MetricBinding"
          },
          "title": "Metric Bindings",
          "type": "array"
        },
        "resource_bindings": {
          "items": {
            "$ref": "#/$defs/ResourceBinding"
          },
          "title": "Resource Bindings",
          "type": "array"
        },
        "slot_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id"
      ],
      "title": "ComponentInstance",
      "type": "object"
    },
    "ComponentSlot": {
      "additionalProperties": false,
      "description": "A component template owned by a service profile.",
      "properties": {
        "endpoints": {
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricContract"
          },
          "title": "Metrics",
          "type": "array"
        },
        "resource_slots": {
          "items": {
            "$ref": "#/$defs/ResourceSlot"
          },
          "title": "Resource Slots",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "ComponentSlot",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "description": "A generic named network endpoint exposed by a service.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "exposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointExposure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/$defs/EndpointProtocol"
        }
      },
      "required": [
        "id",
        "protocol",
        "port"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "EndpointBinding": {
      "additionalProperties": false,
      "description": "Deployment-specific bind addresses for one component endpoint.\n\n``address`` remains accepted for existing catalogs.  ``addresses`` records\na complete multi-address bind set; its first member is the canonical\nobservation target unless an instance override supplies one.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "addresses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Addresses",
          "type": "array"
        },
        "endpoint_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Endpoint Id",
          "type": "string"
        }
      },
      "required": [
        "endpoint_id"
      ],
      "title": "EndpointBinding",
      "type": "object"
    },
    "EndpointExposure": {
      "enum": [
        "private",
        "public"
      ],
      "title": "EndpointExposure",
      "type": "string"
    },
    "EndpointProtocol": {
      "enum": [
        "tcp",
        "http",
        "https",
        "smtp",
        "irc",
        "postgresql",
        "redis"
      ],
      "title": "EndpointProtocol",
      "type": "string"
    },
    "ExternalServiceContract": {
      "additionalProperties": false,
      "description": "An opaque declared external dependency; credentials remain a separate resource.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ExternalServiceContract",
      "type": "object"
    },
    "MetricBinding": {
      "additionalProperties": false,
      "description": "Deployment-specific labels for one declared component metric.",
      "properties": {
        "labels": {
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "string"
            }
          },
          "title": "Labels",
          "type": "object"
        },
        "metric_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Metric Id",
          "type": "string"
        }
      },
      "required": [
        "metric_id"
      ],
      "title": "MetricBinding",
      "type": "object"
    },
    "MetricCondition": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "$ref": "#/$defs/ComparisonOperator"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "operator",
        "threshold"
      ],
      "title": "MetricCondition",
      "type": "object"
    },
    "MetricContract": {
      "additionalProperties": false,
      "description": "One component-owned application metric and readiness assertion.",
      "properties": {
        "allowed_labels": {
          "items": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
            "type": "string"
          },
          "title": "Allowed Labels",
          "type": "array"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoint_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "health_query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Health Query"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "metric_name": {
          "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$",
          "title": "Metric Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "readiness_required": {
          "default": false,
          "title": "Readiness Required",
          "type": "boolean"
        },
        "unit": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "endpoint_id",
        "path",
        "metric_name",
        "unit"
      ],
      "title": "MetricContract",
      "type": "object"
    },
    "ProviderAlias": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "project": {
          "minLength": 1,
          "title": "Project",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider",
        "project",
        "object_id"
      ],
      "title": "ProviderAlias",
      "type": "object"
    },
    "ResourceBinding": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "reference"
      ],
      "title": "ResourceBinding",
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "config",
        "secret",
        "storage",
        "external-service"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "ResourceSlot": {
      "additionalProperties": false,
      "properties": {
        "contract_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Ref"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "ResourceSlot",
      "type": "object"
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "A value-free named secret reference resolved through a provider alias.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "provider_alias_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Provider Alias Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider_alias_id"
      ],
      "title": "SecretReference",
      "type": "object"
    },
    "ServiceInstanceV2": {
      "additionalProperties": false,
      "description": "A host-local instantiation of a v2 service profile.",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentInstance"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "host_id": {
          "title": "Host Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "host_id",
        "profile_id",
        "components"
      ],
      "title": "ServiceInstanceV2",
      "type": "object"
    },
    "ServiceProfileV2": {
      "additionalProperties": false,
      "description": "A reusable service profile composed from component slots.",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentSlot"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "components"
      ],
      "title": "ServiceProfileV2",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One strict observation v2 source document, without planning or projection.",
  "properties": {
    "component_edges": {
      "items": {
        "$ref": "#/$defs/ComponentEdge"
      },
      "title": "Component Edges",
      "type": "array"
    },
    "external_service_contracts": {
      "items": {
        "$ref": "#/$defs/ExternalServiceContract"
      },
      "title": "External Service Contracts",
      "type": "array"
    },
    "provider_aliases": {
      "items": {
        "$ref": "#/$defs/ProviderAlias"
      },
      "title": "Provider Aliases",
      "type": "array"
    },
    "schema_version": {
      "const": "infralink.observation/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_references": {
      "items": {
        "$ref": "#/$defs/SecretReference"
      },
      "title": "Secret References",
      "type": "array"
    },
    "service_instances": {
      "items": {
        "$ref": "#/$defs/ServiceInstanceV2"
      },
      "title": "Service Instances",
      "type": "array"
    },
    "service_profiles": {
      "items": {
        "$ref": "#/$defs/ServiceProfileV2"
      },
      "title": "Service Profiles",
      "type": "array"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "ObservationV2Document",
  "type": "object"
}
