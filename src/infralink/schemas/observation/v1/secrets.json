{
  "$defs": {
    "ProviderAlias": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "project": {
          "minLength": 1,
          "title": "Project",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider",
        "project",
        "object_id"
      ],
      "title": "ProviderAlias",
      "type": "object"
    },
    "RendererBindingIdentity": {
      "additionalProperties": false,
      "properties": {
        "binding_ref": {
          "minLength": 1,
          "title": "Binding Ref",
          "type": "string"
        },
        "delivery_forms": {
          "items": {
            "$ref": "#/$defs/SecretDeliveryForm"
          },
          "title": "Delivery Forms",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "renderer": {
          "minLength": 1,
          "title": "Renderer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "renderer",
        "binding_ref"
      ],
      "title": "RendererBindingIdentity",
      "type": "object"
    },
    "SecretBinding": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Alias",
          "type": "string"
        },
        "delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretDeliveryForm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "renderer_binding_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renderer Binding Id"
        },
        "slot_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slot_id",
        "alias"
      ],
      "title": "SecretBinding",
      "type": "object"
    },
    "SecretDeliveryForm": {
      "enum": [
        "environment",
        "file",
        "stdin"
      ],
      "title": "SecretDeliveryForm",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "provider_aliases": {
      "items": {
        "$ref": "#/$defs/ProviderAlias"
      },
      "title": "Provider Aliases",
      "type": "array"
    },
    "registry_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registry Revision"
    },
    "renderer_binding_identities": {
      "items": {
        "$ref": "#/$defs/RendererBindingIdentity"
      },
      "title": "Renderer Binding Identities",
      "type": "array"
    },
    "renderer_bindings": {
      "items": {
        "$ref": "#/$defs/RendererBindingIdentity"
      },
      "title": "Renderer Bindings",
      "type": "array"
    },
    "schema_version": {
      "const": "infralink.observation/v1",
      "default": "infralink.observation/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_bindings": {
      "items": {
        "$ref": "#/$defs/SecretBinding"
      },
      "title": "Secret Bindings",
      "type": "array"
    }
  },
  "title": "SecretsDocument",
  "type": "object"
}
