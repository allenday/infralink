{
  "$defs": {
    "Application": {
      "additionalProperties": false,
      "properties": {
        "health_signal_refs": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9/-]*[a-z0-9])?$",
            "type": "string"
          },
          "title": "Health Signal Refs",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "required_dependency_edge_ids": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "type": "string"
          },
          "title": "Required Dependency Edge Ids",
          "type": "array"
        },
        "service_instance_ids": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9/-]*[a-z0-9])?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Service Instance Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "service_instance_ids"
      ],
      "title": "Application",
      "type": "object"
    },
    "EndpointExposure": {
      "enum": [
        "private",
        "public"
      ],
      "title": "EndpointExposure",
      "type": "string"
    },
    "EndpointOverride": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "endpoint_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "exposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointExposure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        }
      },
      "required": [
        "endpoint_id"
      ],
      "title": "EndpointOverride",
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "properties": {
        "baseline_capabilities": {
          "items": {
            "$ref": "#/$defs/HostBaselineCapability"
          },
          "title": "Baseline Capabilities",
          "type": "array"
        },
        "controller_managed": {
          "default": false,
          "title": "Controller Managed",
          "type": "boolean"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "host_bridge_ingress": {
          "items": {
            "$ref": "#/$defs/HostBridgeIngress"
          },
          "title": "Host Bridge Ingress",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Host",
      "type": "object"
    },
    "HostBaselineCapability": {
      "enum": [
        "self-deploy-authority",
        "docker",
        "host-metrics",
        "container-metrics",
        "log-forwarding"
      ],
      "title": "HostBaselineCapability",
      "type": "string"
    },
    "HostBridgeIngress": {
      "additionalProperties": false,
      "description": "One registry-declared bridge-to-host firewall allowance.",
      "properties": {
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "service_instance_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Service Instance Id",
          "type": "string"
        }
      },
      "required": [
        "service_instance_id",
        "protocol",
        "port"
      ],
      "title": "HostBridgeIngress",
      "type": "object"
    },
    "RuntimeNetworkScope": {
      "description": "The service network namespace derived from its registry Compose declaration.",
      "enum": [
        "bridge",
        "host"
      ],
      "title": "RuntimeNetworkScope",
      "type": "string"
    },
    "ServiceInstance": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "endpoint_ids": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "type": "string"
          },
          "title": "Endpoint Ids",
          "type": "array"
        },
        "endpoint_overrides": {
          "items": {
            "$ref": "#/$defs/EndpointOverride"
          },
          "title": "Endpoint Overrides",
          "type": "array"
        },
        "host_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Id"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "network_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeNetworkScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "title": "Profile Id",
          "type": "string"
        },
        "secret_binding_ids": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "type": "string"
          },
          "title": "Secret Binding Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "profile_id"
      ],
      "title": "ServiceInstance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applications": {
      "items": {
        "$ref": "#/$defs/Application"
      },
      "title": "Applications",
      "type": "array"
    },
    "hosts": {
      "items": {
        "$ref": "#/$defs/Host"
      },
      "title": "Hosts",
      "type": "array"
    },
    "registry_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registry Revision"
    },
    "schema_version": {
      "const": "infralink.observation/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "service_instances": {
      "items": {
        "$ref": "#/$defs/ServiceInstance"
      },
      "title": "Service Instances",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "service_instances"
  ],
  "title": "InstanceDocument",
  "type": "object"
}
